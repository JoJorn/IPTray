<Window x:Class="IPTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPTray"
        Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        Deactivated="OnDeactivated" KeyDown="OnKeyDown">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,6,12" />
        </Style>
    </Window.Resources>

    <Border Padding="20"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            BorderBrush="#40808080" BorderThickness="1">
        <StackPanel>

            <!-- Header -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="&#xE839;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="IPTray" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="&#xE72C;" ToolTip="Refresh"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Padding="8" Click="OnRefresh" />
            </Grid>

            <!-- Adapter -->
            <TextBlock Text="Network adapter" Style="{StaticResource Label}" />
            <ComboBox x:Name="AdapterBox" DisplayMemberPath="Display"
                      HorizontalAlignment="Stretch" SelectionChanged="OnAdapterChanged" />

            <!-- Mode -->
            <StackPanel Orientation="Horizontal" Margin="0,16,0,14">
                <RadioButton x:Name="DhcpRadio" Content="Automatic (DHCP)" GroupName="Mode" />
                <RadioButton x:Name="StaticRadio" Content="Manual" GroupName="Mode" Margin="20,0,0,0" />
            </StackPanel>

            <!-- Static fields -->
            <UniformGrid x:Name="StaticFields" Columns="2"
                         IsEnabled="{Binding IsChecked, ElementName=StaticRadio}">
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="IP address" Style="{StaticResource Label}" />
                    <TextBox x:Name="IpBox" />
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="Subnet mask or /prefix" Style="{StaticResource Label}" />
                    <TextBox x:Name="MaskBox" />
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="Gateway (optional)" Style="{StaticResource Label}" />
                    <TextBox x:Name="GatewayBox" />
                </StackPanel>
                <StackPanel Style="{StaticResource Field}">
                    <TextBlock Text="DNS (comma separated)" Style="{StaticResource Label}" />
                    <TextBox x:Name="DnsBox" />
                </StackPanel>
            </UniformGrid>

            <!-- Footer -->
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="0,0,12,0" />
                <Button x:Name="ApplyButton" Grid.Column="1" Content="Apply" MinWidth="100"
                        IsDefault="True" Click="OnApply"
                        Style="{DynamicResource AccentButtonStyle}" />
            </Grid>

        </StackPanel>
    </Border>
</Window>
